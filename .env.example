# Copy to .env, fill in your values, then run:  source .env

# Snowflake (use the bare account identifier, without .snowflakecomputing.com)
export SNOWFLAKE_ACCOUNT=your_account_identifier
export SNOWFLAKE_USER=your_user
export SNOWFLAKE_PASSWORD=your_password
export SNOWFLAKE_ROLE=TRANSFORMER
export SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
export SNOWFLAKE_DATABASE=PAYBRIDGE

# Partners (ids are comma separated; each needs <ID>_URL and <ID>_KEY)
export PARTNER_IDS=partner_a,partner_b
export PARTNER_A_URL=http://127.0.0.1:5000
export PARTNER_A_KEY=key-a
export PARTNER_B_URL=http://127.0.0.1:5000
export PARTNER_B_KEY=key-b
